# Admin panel (/admin) password
ADMIN_PASSWORD=change-this-password

# Secret key for signing sessions (at least 32 characters): openssl rand -hex 32
SESSION_SECRET=

# Public address of the site
SITE_URL=https://example.uz

# Data folder (database and photos). Default: ./data
# DATA_DIR=/var/lib/productstore

# Set to 0 to keep demo products out of a new database
# SEED_DEMO=0
